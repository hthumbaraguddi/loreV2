.prompt-editor {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: var(--color-bg-secondary);
}

// Header
.editor-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-4);
  border-bottom: 1px solid var(--color-border-primary);

  h2 {
    font-size: var(--font-size-xl);
    font-weight: 600;
    color: var(--color-text-primary);
    margin: 0;
  }
}

// Tabs
.editor-tabs {
  display: flex;
  gap: 1px;
  background: var(--color-border-primary);
  border-bottom: 1px solid var(--color-border-primary);
}

.tab {
  flex: 1;
  padding: var(--space-3) var(--space-4);
  background: var(--color-bg-tertiary);
  border: none;
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
  font-weight: 500;
  cursor: pointer;
  transition: all 180ms ease;

  &:hover {
    background: var(--color-bg-secondary);
    color: var(--color-text-primary);
  }

  &.active {
    background: var(--color-bg-secondary);
    color: var(--color-accent-primary);
    border-bottom: 2px solid var(--color-accent-primary);
  }
}

// Errors
.errors {
  padding: var(--space-3) var(--space-4);
  background: #fee;
  border-bottom: 1px solid #fcc;
}

.error {
  color: #c00;
  font-size: var(--font-size-sm);
  margin-bottom: var(--space-1);

  &:last-child {
    margin-bottom: 0;
  }
}

// Body
.editor-body {
  flex: 1;
  overflow-y: auto;
  padding: var(--space-4);
}

.tab-content {
  max-width: 800px;
  margin: 0 auto;
}

// Form Elements
.form-group {
  margin-bottom: var(--space-4);

  label {
    display: block;
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
  }
}

.form-input,
.form-textarea,
.form-select {
  width: 100%;
  padding: var(--space-2) var(--space-3);
  background: var(--color-bg-primary);
  border: 1px solid var(--color-border-primary);
  border-radius: var(--radius-md);
  color: var(--color-text-primary);
  font-size: var(--font-size-base);
  font-family: var(--font-sans);
  transition: all 180ms ease;

  &:focus {
    outline: none;
    border-color: var(--color-accent-primary);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
  }

  &::placeholder {
    color: var(--color-text-tertiary);
  }

  &.error {
    border-color: #c00;
  }
}

.form-textarea {
  resize: vertical;
  font-family: var(--font-sans);
  line-height: 1.5;

  &.template-textarea {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
  }
}

.form-range {
  width: 100%;
  height: 6px;
  background: var(--color-bg-tertiary);
  border-radius: var(--radius-full);
  outline: none;
  -webkit-appearance: none;

  &::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 18px;
    height: 18px;
    background: var(--color-accent-primary);
    border-radius: 50%;
    cursor: pointer;
    transition: all 180ms ease;

    &:hover {
      transform: scale(1.2);
    }
  }

  &::-moz-range-thumb {
    width: 18px;
    height: 18px;
    background: var(--color-accent-primary);
    border-radius: 50%;
    cursor: pointer;
    border: none;
    transition: all 180ms ease;

    &:hover {
      transform: scale(1.2);
    }
  }
}

.range-labels {
  display: flex;
  justify-content: space-between;
  margin-top: var(--space-1);
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
}

.checkbox-label {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  cursor: pointer;
  font-weight: normal;

  input[type="checkbox"] {
    width: 18px;
    height: 18px;
    cursor: pointer;
  }
}

.help-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  margin-top: var(--space-1);

  code {
    padding: 2px 6px;
    background: var(--color-bg-tertiary);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
  }
}

.template-help {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-2);
  padding: var(--space-2);
  background: var(--color-bg-tertiary);
  border-radius: var(--radius-sm);

  code {
    padding: 2px 6px;
    background: var(--color-bg-primary);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    color: var(--color-accent-primary);
  }
}

// Tags Input
.tags-input {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.tag {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  padding: var(--space-1) var(--space-2);
  background: var(--color-accent-primary);
  color: white;
  border-radius: var(--radius-full);
  font-size: var(--font-size-sm);
}

.tag-remove {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 16px;
  height: 16px;
  background: rgba(255, 255, 255, 0.2);
  border: none;
  border-radius: 50%;
  color: white;
  font-size: 10px;
  cursor: pointer;
  transition: all 180ms ease;

  &:hover {
    background: rgba(255, 255, 255, 0.3);
  }
}

.tag-input {
  padding: var(--space-2) var(--space-3);
  background: var(--color-bg-primary);
  border: 1px solid var(--color-border-primary);
  border-radius: var(--radius-md);
  color: var(--color-text-primary);
  font-size: var(--font-size-sm);

  &:focus {
    outline: none;
    border-color: var(--color-accent-primary);
  }
}

// Variable Chips
.variable-chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-top: var(--space-2);
}

.variable-chip {
  padding: var(--space-1) var(--space-2);
  background: var(--color-bg-tertiary);
  border: 1px solid var(--color-border-primary);
  border-radius: var(--radius-sm);
  font-family: var(--font-mono);
  font-size: var(--font-size-xs);
  color: var(--color-accent-primary);
  cursor: pointer;
  transition: all 180ms ease;

  &:hover {
    background: var(--color-accent-primary);
    color: white;
    border-color: var(--color-accent-primary);
  }
}

// Variables Tab
.variables-header {
  display: flex;
  justify-content: space-between;
  align-items: start;
  margin-bottom: var(--space-4);

  .help-text {
    flex: 1;
    margin: 0;
  }
}

.variables-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.variable-item {
  display: flex;
  justify-content: space-between;
  align-items: start;
  padding: var(--space-3);
  background: var(--color-bg-primary);
  border: 1px solid var(--color-border-primary);
  border-radius: var(--radius-md);
}

.variable-info {
  flex: 1;
}

.variable-name {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-1);

  code {
    padding: 2px 6px;
    background: var(--color-bg-tertiary);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    color: var(--color-accent-primary);
  }
}

.variable-type {
  padding: 2px 8px;
  background: var(--color-bg-tertiary);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  text-transform: uppercase;
}

.required-badge {
  padding: 2px 8px;
  background: #fee;
  color: #c00;
  border-radius: var(--radius-sm);
  font-size: var(--font-size-xs);
  font-weight: 500;
}

.variable-label {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  margin-bottom: var(--space-1);
}

.variable-meta,
.variable-options {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);

  span {
    margin-right: var(--space-3);
  }
}

.variable-actions {
  display: flex;
  gap: var(--space-1);
}

// Variable Form
.variable-form {
  padding: var(--space-4);
  background: var(--color-bg-primary);
  border: 2px solid var(--color-accent-primary);
  border-radius: var(--radius-lg);
  margin-top: var(--space-4);

  .form-header {
    margin-bottom: var(--space-4);

    h3 {
      font-size: var(--font-size-lg);
      font-weight: 600;
      color: var(--color-text-primary);
      margin: 0;
    }
  }
}

.form-actions {
  display: flex;
  justify-content: flex-end;
  gap: var(--space-2);
  margin-top: var(--space-4);
}

// Schedule Tab
.preset-buttons {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: var(--space-2);
}

.preset-btn {
  padding: var(--space-3);
  background: var(--color-bg-primary);
  border: 1px solid var(--color-border-primary);
  border-radius: var(--radius-md);
  text-align: left;
  cursor: pointer;
  transition: all 180ms ease;

  &:hover {
    border-color: var(--color-accent-primary);
    box-shadow: var(--shadow-sm);
  }

  &.active {
    background: var(--color-accent-primary);
    border-color: var(--color-accent-primary);
    color: white;

    .preset-label,
    .preset-desc {
      color: white;
    }
  }
}

.preset-label {
  font-size: var(--font-size-sm);
  font-weight: 500;
  color: var(--color-text-primary);
  margin-bottom: var(--space-1);
}

.preset-desc {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.validation-message {
  margin-top: var(--space-2);
  padding: var(--space-2);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-sm);

  &.error {
    background: #fee;
    color: #c00;
  }

  &.success {
    background: #efe;
    color: #060;
  }
}

.schedule-info {
  margin-top: var(--space-4);
}

.info-card {
  padding: var(--space-3);
  background: var(--color-bg-primary);
  border: 1px solid var(--color-border-primary);
  border-radius: var(--radius-md);
}

.info-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  margin-bottom: var(--space-1);
}

.info-value {
  font-size: var(--font-size-base);
  font-weight: 500;
  color: var(--color-accent-primary);
}

// Empty State
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-8);
  text-align: center;

  .empty-icon {
    font-size: 48px;
    margin-bottom: var(--space-3);
    opacity: 0.5;
  }

  p {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-3);
  }
}

// Footer
.editor-footer {
  display: flex;
  justify-content: flex-end;
  gap: var(--space-2);
  padding: var(--space-4);
  border-top: 1px solid var(--color-border-primary);
}

// Buttons
.btn-primary,
.btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) var(--space-4);
  border-radius: var(--radius-md);
  font-size: var(--font-size-sm);
  font-weight: 500;
  cursor: pointer;
  transition: all 180ms ease;
  border: none;
}

.btn-primary {
  background: var(--color-accent-primary);
  color: white;

  &:hover {
    background: var(--color-accent-secondary);
  }
}

.btn-secondary {
  background: var(--color-bg-primary);
  color: var(--color-text-primary);
  border: 1px solid var(--color-border-primary);

  &:hover {
    background: var(--color-bg-tertiary);
    border-color: var(--color-border-secondary);
  }
}

.btn-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border: none;
  background: transparent;
  color: var(--color-text-secondary);
  cursor: pointer;
  border-radius: var(--radius-sm);
  transition: all 180ms ease;

  &:hover {
    background: var(--color-bg-tertiary);
    color: var(--color-text-primary);
  }

  &.danger:hover {
    background: #fee;
    color: #c00;
  }
}
